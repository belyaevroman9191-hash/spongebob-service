{
  "version": 2,
  "functions": {
    "api/[...path].js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" }
  ],
  "headers": [
    { "source": "/(.*)\\.(js|css|png|jpg|jpeg|ico|mp3)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
  ]
}
