{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/admin",
      "dest": "admin.html"
    },
    {
      "src": "/admin.html",
      "dest": "admin.html"
    },
    {
      "src": "/admin.js",
      "dest": "admin.js"
    },
    {
      "src": "/admin.css",
      "dest": "admin.css"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
